{
    "name": "Personal PyTorch 2.8 CUDA 12.8 Dev",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "../../.."
    },
    "runArgs": [
        "--gpus",
        "all"
    ],
    "workspaceFolder": "/root/Codes",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/Codes,type=bind",
    "mounts": [
        "source=${localEnv:HOME}/.ssh/github-key.pub,target=/root/.ssh/github-key.pub,type=bind,readonly"
    ],
    "postStartCommand": "git config --global gpg.format ssh && git config --global user.signingkey /root/.ssh/github-key.pub",
    "customizations": {
        "vscode": {
            "extensions": [
                "github.vscode-github-actions",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.vscode-python-envs",
                "ms-toolsai.jupyter-keymap",
                "openai.chatgpt",
                "tomoki1207.pdf",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "remoteUser": "root"
}
